# Keep generated text artifacts reviewable and avoid CRLF being reported as
# trailing whitespace by Git's diff checker.
*.csv text eol=lf
*.tsv text eol=lf
*.json text eol=lf
*.log text eol=lf
*.txt text eol=lf
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

*.npz binary
events.out.tfevents.* binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.zip binary
*.svg text eol=lf
